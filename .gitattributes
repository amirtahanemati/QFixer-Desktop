# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force scripts to keep LF
*.sh text eol=lf
*.bash text eol=lf

# Windows specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.onnx binary
*.pt binary
